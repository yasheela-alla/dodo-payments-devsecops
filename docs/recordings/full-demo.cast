[0.079, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\u001b[1;33mDodo Payments — Security & DevOps assignment\u001b[0m\r\n"]
[0.009, "o", "\u001b[2mLive end-to-end walkthrough · 2026-07-29 23:22 IST\u001b[0m\r\n"]
[1.507, "o", "\r\n\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n\u001b[1;36m  0 · The stack is real (OrbStack → kind → Calico → Istio)\u001b[0m\r\n\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n"]
[1.217, "o", "\r\n\u001b[1;33m▸ kind nodes running as containers\u001b[0m\r\n"]
[1.102, "o", "NAMES                STATUS\r\nvulntarget           Up 8 hours\r\ndodo-control-plane   Up 10 hours\r\ndodo-worker2         Up 10 hours\r\ndodo-worker          Up 10 hours\r\n"]
[1.614, "o", "\r\n\u001b[1;33m▸ workload pods (2/2 = app + Istio sidecar), in the PCI namespace\u001b[0m\r\n"]
[0.875, "o", "NAME                          READY   STATUS    RESTARTS        AGE\r\nintruder-66c478ff94-gd5bd     2/2     Running   0               9h\r\nledger-api-77d666c948-jfftt   2/2     Running   1 (7h7m ago)    8h\r\nledger-api-77d666c948-mv8bg   "]
[0.000, "o", "2/2     Running   3 (5h15m ago)   8h\r\nreporting-559bcdf748-6qpzq    2/2     Running   0               9h\r\n"]
[1.614, "o", "\r\n"]
[0.000, "o", "\u001b[1;33m▸ the RUNNING image is the cosign-SIGNED GHCR digest (CI promoted it, ArgoCD deployed it)\u001b[0m\r\n"]
[0.706, "o", "ghcr.io/yasheela-alla/ledger-api@sha256:d642d2af4eaa5e7c2246fdf31a20f9a4be55241732b3cca1563bc6b58a47992a"]
[0.002, "o", "\r\n"]
[1.614, "o", "\r\n\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m  1 · Workload hardening + admission guardrails\u001b[0m\r\n\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n"]
[1.220, "o", "\r\n\u001b[1;33m▸ container securityContext — non-root, read-only, caps dropped, seccomp\u001b[0m\r\n"]
[0.752, "o", "{\r\n    \u001b[1m\"allowPrivilegeEscalation\"\u001b[0m: \u001b[1;34mfalse\u001b[0m,\r\n    \u001b[1m\"capabilities\"\u001b[0m: {\r\n        \u001b[1m\"drop\"\u001b[0m: [\r\n            \u001b[32m\"ALL\"\u001b[0m\r\n        ]\r\n    },\r\n    \u001b[1m\"privileged\"\u001b[0m: \u001b[1;34mfalse\u001b[0m,\r\n    \u001b[1m\"readOnlyRootFilesystem\"\u001b[0m: \u001b[1;34mtrue\u001b[0m,\r\n    \u001b[1m\"runAsNonRoot\"\u001b[0m: \u001b[1;34mtrue\u001b[0m,\r\n    \u001b[1m\"runAsUser\"\u001b[0m: \u001b[33m10001\u001b[0m,\r\n    \u001b[1m\"seccompProfile\"\u001b[0m: {\r\n        \u001b[1m\"type\"\u001b[0m: \u001b[32m\"RuntimeDefault\"\u001b[0m\r\n    }\r\n}\r\n"]
[1.614, "o", "\r\n\u001b[1;33m▸ least privilege — can the app / neighbour read Secrets?\u001b[0m\r\n"]
[0.688, "o", "  ledger-api SA get secrets : \u001b[1;31mno\u001b[0m\r\n"]
[0.050, "o", "  reporting  SA get secrets : \u001b[1;31mno\u001b[0m\r\n"]
[1.609, "o", "\r\n"]
[0.000, "o", "\u001b[1;33m▸ admission REJECTS the original insecure Deployment (PSS + Kyverno)\u001b[0m\r\n"]
[0.818, "o", "Warning: would violate PodSecurity \"restricted:latest\": allowPrivilegeEscalation != false (container \"ledger-api-insecure\" must set securityContext.allowPrivilegeEscalation=false), unrestricted capabilities (container \"ledger-api-insecure\" must set securityContext.capabilities.drop=[\"ALL\"]), runAsNonRoot != true (pod or container \"ledger-api-insecure\" must set securityContext.runAsNonRoot=true), seccompProfile (pod or container \"ledger-api-insecure\" must set securityContext.seccompProfile.type to \"RuntimeDefault\" or \"Localhost\")\r\nError from server: error when creating \"STDIN\": admission webhook \"validate.kyverno.svc-fail\" denied the request: \r\nresource Deployment/payments/ledger-api-insecure was blocked due to the following policies \r\ndisallow-run-as-root:\r\n"]
[0.000, "o", "  \u001b[1;32m=> insecure workload blocked before scheduling\u001b[0m\r\n"]
[1.611, "o", "\r\n\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n\u001b[1;36m  2 · Supply chain — only signed images run\u001b[0m\r\n\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n"]
[1.215, "o", "\r\n"]
[0.000, "o", "\u001b[1;33m▸ Kyverno verified the cosign signature at admission (positive)\u001b[0m\r\n"]
[0.770, "o", "{\"ghcr.io/yasheela-alla/ledger-api@sha256:d642d2af4eaa5e7c2246fdf31a20f9a4be55241732b3cca1563bc6b58a47992a\":\"pass\"}"]
[0.001, "o", "\r\n"]
[1.614, "o", "\r\n"]
[0.000, "o", "\u001b[1;33m▸ an UNSIGNED image is rejected at admission (negative control)\u001b[0m\r\n"]
[25.149, "o", "  \u001b[1;31mresource Pod/payments/unsigned-demo was blocked due to the following policies \u001b[0m\r\n  \u001b[1;31m    .attestors[0].entries[0].keyless: no signatures found'\u001b[0m\r\n"]
[0.231, "o", "  \u001b[1;32m=> only images signed by our GitHub workflow can run\u001b[0m\r\n"]
[1.614, "o", "\r\n"]
[0.000, "o", "\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m  3 · Zero-trust — mTLS + identity authz + NetworkPolicy\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n"]
[1.223, "o", "\r\n\u001b[1;33m▸ mTLS STRICT enforced (effective workload mode)\u001b[0m\r\n"]
[1.329, "o", "  \u001b[1;32m   Workload mTLS mode: STRICT\u001b[0m\r\n"]
[1.617, "o", "\r\n\u001b[1;33m▸ authorization by SPIFFE identity, not IP\u001b[0m\r\n"]
[1.731, "o", "  reporting (authorized) -> /health : \u001b[1;32m200\u001b[0m\r\n"]
[0.534, "o", "  intruder  (unauthorized)-> /health : \u001b[1;31m403\u001b[0m  \u001b[2m(reachable, but wrong identity)\u001b[0m\r\n"]
[1.616, "o", "\r\n\u001b[1;33m▸ NetworkPolicy egress containment — SSRF blast-radius = 0\u001b[0m\r\n"]
[0.615, "o", "  ledger-api -> 169.254.169.254 (cloud metadata): "]
[5.334, "o", "\u001b[1;31mBLOCKED (TimeoutError)\u001b[0m\r\n"]
[1.649, "o", "\r\n"]
[0.000, "o", "\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m  4 · Offensive — exploit the vulnerable app, then prove it's fixed\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n"]
[1.218, "o", "\r\n"]
[0.000, "o", "\u001b[1;33m▸ VULNERABLE target: unauthenticated full-PAN disclosure\u001b[0m\r\n"]
[0.719, "o", "  \u001b[1;31m4242424242424242\u001b[0m txn_1001\r\n  \u001b[1;31m5555555555554444\u001b[0m txn_1002\r\n"]
[1.631, "o", "\r\n\u001b[1;33m▸ chain: YAML deserialization RCE -> exfiltrate secrets, as root\u001b[0m\r\n"]
[1.498, "o", "  injected command ran as: \u001b[1;31muid=0(root) gid=0(root) groups=0(root)\u001b[0m\r\n"]
[0.084, "o", "  \u001b[1;31mSTRIPE_API_KEY=sk_live_FAKE-DEMO-KEY-not-real\u001b[0m\r\n  \u001b[1;31mDB_PASSWORD=demo-db-pass-not-real\u001b[0m\r\n"]
[1.620, "o", "\r\n"]
[0.000, "o", "\u001b[1;33m▸ RETEST on the HARDENED app — every finding closed\u001b[0m\r\n"]
[0.715, "o", "  /transactions no-auth : \u001b[1;32m401\u001b[0m  \u001b[2m(401; was 200 + full PAN)\u001b[0m\r\n"]
[0.060, "o", "  /import RCE gadget     : \u001b[1;32minvalid yaml\u001b[0m  \u001b[2m(no execution)\u001b[0m\r\n"]
[0.020, "o", "  /fetch SSRF metadata  : \u001b[1;32m{\"error\":\"refusing to fetch a non-public address\"}\u001b[0m\r\n"]
[1.611, "o", "\r\n\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n\u001b[1;36m  Defense-in-depth: prevented in code · gated in CI · contained at runtime · segmented on the network\u001b[0m\r\n\u001b[1;36m════════════════════════════════════════════════════════════\u001b[0m\r\n"]
